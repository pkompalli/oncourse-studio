# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM: every call goes through the shared ai-proxy (OpenAI Responses API, GPT 6.1 Sol)
AI_PROXY_URL=https://ai-proxy.getoncourse.ai/v1
AI_PROXY_KEY=your-ai-proxy-key

# Image generation also goes through the ai-proxy (OpenAI images API)
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Other APIs
GEMINI_API_KEY=your-gemini-key

# Server
PORT=3001
